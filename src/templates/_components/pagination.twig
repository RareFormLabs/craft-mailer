{% if totalPages > 1 %}
    <nav class="mailer-pagination" aria-label="{{ 'Pagination'|t('app') }}">
        {% if page > 1 %}
            <a class="btn" href="{{ url(craft.app.request.pathInfo, params|merge({page: page - 1})) }}">{{ 'Previous'|t('mailer') }}</a>
        {% endif %}
        <span class="light">{{ 'Page {page} of {totalPages}'|t('mailer', {page: page, totalPages: totalPages}) }}</span>
        {% if page < totalPages %}
            <a class="btn" href="{{ url(craft.app.request.pathInfo, params|merge({page: page + 1})) }}">{{ 'Next'|t('mailer') }}</a>
        {% endif %}
    </nav>
{% endif %}
