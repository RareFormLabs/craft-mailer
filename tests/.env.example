# Copy to tests/.env for the integration tests.
# (If PHP runs in a container, e.g. Lerd, use host=host.containers.internal.)
# The suite wipes and reinstalls this database — use a dedicated, empty one.
CRAFT_DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=craft_mailer_test"
CRAFT_DB_USER="root"
CRAFT_DB_PASSWORD=""
CRAFT_DB_TABLE_PREFIX=""
CRAFT_DB_SCHEMA=""
CRAFT_SECURITY_KEY="mailer-test-security-key"
