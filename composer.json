{
  "name": "rareform/craft-mailer",
  "description": "Send emails to users, user groups and custom recipients from the Craft CMS control panel.",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "craft-plugin",
    "mailer",
    "email",
    "newsletter"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Rareform"
    }
  ],
  "support": {
    "source": "https://github.com/RareFormLabs/craft-mailer",
    "docs": "https://github.com/RareFormLabs/craft-mailer/blob/main/README.md",
    "issues": "https://github.com/RareFormLabs/craft-mailer/issues"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.6.0",
    "verbb/tiptap": "^1.0.2"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "rareform\\mailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "rareform\\mailer\\tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Mailer",
    "handle": "mailer",
    "developer": "RareForm",
    "documentationUrl": "https://github.com/RareFormLabs/craft-mailer/blob/main/README.md"
  },
  "scripts": {
    "check-cs": "php -d error_reporting=8191 vendor/bin/ecs check --ansi",
    "fix-cs": "php -d error_reporting=8191 vendor/bin/ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  }
}
