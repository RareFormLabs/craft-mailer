{
  "name": "rareform/craft-mailer",
  "description": "Send personalized emails to users, user groups and any address from the Craft control panel, with scheduling, batching, logs and unsubscribes.",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "craft-plugin",
    "mailer",
    "email",
    "newsletter",
    "bulk email",
    "email marketing"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "Rareform"
    }
  ],
  "support": {
    "source": "https://github.com/RareFormLabs/craft-mailer",
    "docs": "https://github.com/RareFormLabs/craft-mailer/blob/main/README.md",
    "issues": "https://github.com/RareFormLabs/craft-mailer/issues"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.6.0",
    "verbb/tiptap": "^1.0.2"
  },
  "require-dev": {
    "codeception/codeception": "^5.2",
    "codeception/module-asserts": "^3.0",
    "codeception/module-yii2": "^1.1.9",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "vlucas/phpdotenv": "^5.4"
  },
  "autoload": {
    "psr-4": {
      "rareform\\mailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "rareform\\mailer\\tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Mailer",
    "handle": "mailer",
    "class": "rareform\\mailer\\Plugin",
    "description": "Send personalized emails to users, user groups and any address from the control panel.",
    "developer": "RareForm",
    "developerUrl": "https://github.com/RareFormLabs",
    "documentationUrl": "https://github.com/RareFormLabs/craft-mailer/blob/main/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/RareFormLabs/craft-mailer/main/CHANGELOG.md"
  },
  "scripts": {
    "check-cs": "php -d error_reporting=8191 vendor/bin/ecs check --ansi",
    "fix-cs": "php -d error_reporting=8191 vendor/bin/ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit",
    "test-integration": "codecept run integration"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  }
}
